# Keep the build context lean and, importantly, keep a local mm-gateway.yaml
# (which may contain interpolated secrets or real keys) out of the image.
.git/
.github/
.venv/
.pytest_cache/
.vscode/
.idea/

__pycache__/
**/__pycache__/
*.py[codz]
*.egg-info/

# Local config / secrets never belong in the published image.
mm-gateway.yaml
mm-gateway.yml
.env
.envrc

# Dev-only trees.
tests/
docs/
examples/

# Frontend dependencies and locally generated bundles are built in their own stage.
**/node_modules/
web/test-results/
web/playwright-report/
mm_gateway/server/static/admin/
