# Optional Docker Compose overrides. Copy to .env to customize the defaults.
BIND_ADDRESS=127.0.0.1
PORT=8000
GATEWAY_API_KEY=mm-gateway-local
MANAGEMENT_API_KEY=mm-gateway-admin
ROOT_PATH=
LOG_LEVEL=INFO
LOG_FORMAT=json

# Provider credentials can also be added through the management console.
# All environment-based provider settings documented in README.md are supported.
