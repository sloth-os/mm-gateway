# Optional Docker Compose overrides. Copy to .env to customize the defaults.
BIND_ADDRESS=127.0.0.1
PORT=8000
# Optional: leave empty for an open generation API, or manage keys in /admin/.
GATEWAY_API_KEY=
MANAGEMENT_API_KEY=mm-gateway-admin
# Generated automatically in the persistent volume. Override for a mounted key.
# MM_GATEWAY_SECRET_KEY_FILE=/app/data/.mm-gateway.key
ROOT_PATH=
LOG_LEVEL=INFO
LOG_FORMAT=json

# Provider credentials can also be added through the management console.
# All environment-based provider settings documented in README.md are supported.
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# ARK_API_KEY=
# MUREKA_MUSIC_API_KEY=
# OPENAI_AUDIO_API_KEY=
# AZURE_AUDIO_API_KEY=
# AZURE_AUDIO_REGION=eastus
